
def modifier_nom_etudiant(self, id_students, nom):
    query = "UPDATE students SET nom=? WHERE id=?"
    # On passe 'nom' d'abord, puis 'id_students'
    self.cursor.execute(query, (nom, id_students))
    self.connexion.commit() # N'oubliez pas de commit pour enregistrer les modifications



    from services.services_auth import CONNEXION_User
from confige.Menu import  MENU_PROFESSEUR, MENU_ETUDIANT
from utils.gere_choix_utilisateur_principale import gerer_choix_admin





def main():
    role = CONNEXION_User()
    if role == 'admin':
        gerer_choix_admin()
        
    elif role == 'professeur':
        print(MENU_PROFESSEUR)
       
      
    elif role == 'étudiant':
        print(MENU_ETUDIANT)
       
if __name__ == "__main__":
    main()